rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Compte non désactivé par l'admin (champ absent = actif).
    function isActive() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !('active' in u) || u.active == true;
    }
    function isParentOf(childId) {
      return email() in get(/databases/$(database)/documents/children/$(childId)).data.parentEmails;
    }
    function eventEditable(eventId) {
      let ev = get(/databases/$(database)/documents/events/$(eventId)).data;
      return ev.status == 'scheduled' && ev.departureTime > request.time;
    }
    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuth() && request.auth.uid == uid
                    && request.resource.data.role == 'parent'
                    && request.resource.data.active == true;
      allow update: if isAdmin()
                    || (isAuth() && isActive() && request.auth.uid == uid
                        && onlyKeys(['displayName', 'updatedAt']));
    }

    match /children/{childId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isAuth() && isActive() && email() in resource.data.parentEmails
                        && onlyKeys(['addresses', 'updatedAt']));
    }

    match /events/{eventId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      // Inscription d'un enfant : ses parents uniquement (règle 5)
      match /participants/{childId} {
        allow read: if isAuth();
        allow write: if isAdmin()
                     || (isAuth() && isActive() && isParentOf(childId) && eventEditable(eventId)
                         && (request.method == 'delete'
                             || request.resource.data.childId == childId))
                     // File d'attente : retirer une voiture / déplacer un enfant (tout le monde)
                     // remet sa date d'attente à maintenant — seuls ces deux champs.
                     || (isAuth() && isActive() && eventEditable(eventId)
                         && request.method == 'update'
                         && onlyKeys(['queuedAller', 'queuedRetour']));
      }

      // Voiture : créée/supprimée par son chauffeur (règle 4) ;
      // listes de passagers modifiables par tous (règle 6)
      match /cars/{driverUid} {
        allow read: if isAuth();
        allow create, delete: if isAdmin()
                     || (isAuth() && isActive() && request.auth.uid == driverUid && eventEditable(eventId));
        allow update: if isAdmin()
                     || (isAuth() && isActive() && eventEditable(eventId) && (
                          request.auth.uid == driverUid
                          || onlyKeys(['passengersAller', 'passengersRetour', 'updatedAt'])
                        ));
      }
    }

    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}

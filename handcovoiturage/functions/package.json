{
  "name": "handcovoiturage-functions",
  "version": "2.0.0",
  "description": "Cloud Functions HandCovoiturage",
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "rm -rf lib && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "private": true
}
